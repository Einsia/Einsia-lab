---
import { projectPath } from '@/lib/project-paths';
import modelManifest from '../../../public/frontier3d/models/manifest.json';
interface Props { id:string; title:string; model:string; score:number; }
const {id,title,model,score}=Astro.props;
const modelVersion=modelManifest.models.find(m=>m.id===id)?.sha256.slice(0,12);
---
<div class="f3-object-viewer" data-object-viewer data-model-src={projectPath(`/frontier3d/models/${id}.glb`) + `?v=${modelVersion}`} data-decoder={projectPath('/frontier3d/vendor/draco/')} data-label={`${title} — ${model}`}>
  <img class="f3-object-poster" src={projectPath(`/frontier3d/media/${id}.jpg`)} alt={`${title} generated by ${model}`} loading="lazy" width="512" height="320" />
  <div class="f3-object-stage" tabindex="0" role="img" aria-label={`${title} by ${model}. Drag to rotate, scroll or pinch to zoom. Arrow keys rotate, plus and minus zoom, R resets.`}></div>
  <span class="f3-case-score" aria-label={`Evaluation score: ${score.toFixed(2)} out of 100`}>{score.toFixed(2)}<small>/ 100</small></span>
  <button class="f3-object-load" aria-label={`Load interactive ${title} by ${model}`}>Explore in 3D <span>↗</span></button>
  <div class="f3-object-tools" aria-label="3D view controls" hidden>
    <button data-view-action="out" aria-label="Zoom out">−</button><button data-view-action="in" aria-label="Zoom in">+</button><button data-view-action="reset" aria-label="Reset view">↺</button><button data-view-action="expand" aria-label={`Expand ${title} in 3D`}>⤢</button>
  </div>
  <span class="f3-object-status" role="status" aria-live="polite"></span>
</div>
