      "code": "def move_pose(arm, target, gripper=None, max_steps=12, max_delta=0.07, tolerance=0.004):\n    target = np.asarray(target, dtype=float)\n    stalled = 0\n    for attempt in range(max_steps):\n        observation = get_observation()\n        current = np.asarray(observation['endpose'][arm + '_endpose'], dtype=float)\n        error = target[:3] - current[:3]\n        distance = float(np.linalg.norm(error))\n        desired_quat = target[3:] / np.linalg.norm(target[3:])\n        current_quat = current[3:] / np.linalg.norm(current[3:])\n        if np.dot(current_quat, desired_quat) < 0:\n            desired_quat = -desired_quat\n        angle = 2 * float(np.arccos(np.clip(np.dot(current_quat, desired_quat), -1, 1)))\n        if distance < tolerance and angle < 0.04:\n            print('reached', arm, current.tolist())\n            return True\n        command = current.copy()\n        command[:3] += error * min(1.0, max_delta / max(distance, 1e-9))\n        fraction = min(1.0, 0.45 / max(angle, 1e-9))\n        command[3:] = (1-fraction) * current_quat + fraction * desired_quat\n        command[3:] /= np.linalg.norm(command[3:])\n        left = np.asarray(observation['endpose']['left_endpose'], dtype=float)\n        right = np.asarray(observation['endpose']['right_endpose'], dtype=float)\n        left_gripper = observation['endpose']['left_gripper']\n        right_gripper = observation['endpose']['right_gripper']\n        if arm == 'left':\n            left = command\n            if gripper is not None:\n                left_gripper = gripper\n        else:\n            right = command\n            if gripper is not None:\n                right_gripper = gripper\n        updated, reward, terminated, truncated, info = step(np.concatenate([left, [left_gripper], right, [right_gripper]]), action_type='ee')\n        measured = np.asarray(updated['endpose'][arm + '_endpose'], dtype=float)\n        print('tracking', attempt, distance, angle, measured.tolist(), info)\n        if terminated or truncated:\n            return bool(info.get('success'))\n        progress = float(np.linalg.norm(measured[:3]-current[:3])) + float(np.linalg.norm(measured[3:]-current[3:]))\n        stalled = stalled + 1 if progress < 0.001 else 0\n        if stalled >= 2:\n            print('stalled')\n            return False\n    return False\n\n\n# The red cube is on the right at approximately (0.1575, -0.0808), with top z=0.770.\n# Approach above it with the right gripper open before a separate careful descent.\ndownward = np.asarray([0.5, -0.5, 0.5, 0.5])\nred_xy = np.asarray([0.1575, -0.0808])\ngreen_xy = np.asarray([-0.1918, 0.0207])\nprint(move_pose('right', np.concatenate([red_xy, [0.950], downward]), gripper=1.0, max_steps=10, max_delta=0.055))\nprint(get_observation()['endpose'])\n",
