---
/**
 * The three-rung grading ladder, with what each rung asks, how it decides, what
 * it can see, and what failing it costs. The "what it can see" row is the point:
 * the reviewer is given no compiler, and only rung 3 gets both trees.
 *
 * The bar under each rung is that rung's own pass rate — what it passed over
 * what it was handed — so the three are not a shrinking funnel and are not meant
 * to read as one. Rung 2 is the narrowest because it is the hardest, not because
 * fewer runs reached it. Its denominator is the gate survivors, not the campaign:
 * 118 runs scored a perfect suite, but 30 of those had already failed rung 1 and
 * are reported uncredited, so the rung passed 88.
 */
interface Props {
  funnel: {
    total: number;
    gatePass: number;
    ceiling: number;
    admitted: number;
    accepted: number;
    rungs: { n: number; entered: number; survived: number; rate: number }[];
  };
}
const { funnel: f } = Astro.props;
const [g1, g2, g3] = f.rungs;

const rungs = [
  {
    n: "1",
    name: "Integrity reviewer",
    asks: "Did the migration actually happen?",
    decides:
      "A model reads both trees and answers each gate with cited evidence, over 3 samples.",
    sees:
      "Both trees and code-reading tools — no build system, and no compiler for the language under test.",
    onFail:
      "Scores 0 and skips rung 3. Rung 2 still runs, reported uncredited.",
    stat: `${g1.survived} of ${g1.entered} runs passed`,
    pct: g1.rate,
  },
  {
    n: "2",
    name: "Functional core",
    asks: "How much of the behavior survived?",
    decides:
      "Weighted modules build the submission and compare it against thousands of expectations frozen from the original.",
    sees:
      "The target toolchain, offline, with the original's engine asserted absent at image-build time.",
    onFail:
      `All-or-nothing: only a perfect core opens rung 3, and the weighted rate pays nothing. ${f.ceiling} runs in all were perfect here, ${f.ceiling - f.admitted} of them after failing rung 1.`,
    stat: `${g2.survived} of those ${g2.entered} were perfect`,
    pct: g2.rate,
  },
  {
    n: "3",
    name: "Agentic verifier",
    asks: "What did the frozen suite fail to ask?",
    decides:
      "6 models, 1 hour each, must each write a program that passes on the original and fails on the submission.",
    sees:
      "Both toolchains, offline — “the original does X” is worth nothing unless the original is there to demonstrate it.",
    onFail:
      "10 of the composite's 100 points per verifier that fails to break the submission, 60 if all six do.",
    stat: `${g3.survived} of those ${g3.entered} survived all six`,
    pct: g3.rate,
  },
];
---

<ol class="grid grid-cols-1 md:grid-cols-3 gap-5">
  {
    rungs.map((r) => (
      <li class="flex flex-col overflow-hidden rounded-xl border border-line bg-paper-white">
        {/* Name, with the rung number as a badge rather than a large numeral. */}
        <div class="flex items-center gap-2.5 px-5 pt-4">
          <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-ink text-xs font-bold tabular-nums text-white">
            {r.n}
          </span>
          <h3 class="font-serif text-lg font-bold leading-tight text-ink">
            {r.name}
          </h3>
        </div>

        {/* The question the rung asks: the card's subject, on its own ground. */}
        <p class="mt-3.5 border-y border-line bg-paper-2 px-5 py-3 font-serif text-base italic leading-snug text-ink">
          {r.asks}
        </p>

        <dl class="flex flex-1 flex-col gap-3.5 px-5 py-4">
          {[
            { k: "How it decides", v: r.decides },
            { k: "What it can see", v: r.sees },
            { k: "On failure", v: r.onFail },
          ].map((row) => (
            <div>
              <dt class="text-[0.63rem] font-semibold uppercase tracking-[0.09em] text-ink-3">
                {row.k}
              </dt>
              <dd class="mt-1 text-[0.82rem] leading-relaxed text-ink-2">
                {row.v}
              </dd>
            </div>
          ))}
        </dl>

        {/* The rate, drawn and printed. funnel.mjs matches the bar's
            style/title pair and the stat paragraph's class and text exactly, so
            both stay as they are. */}
        <div class="border-t border-line px-5 py-3">
          <div class="h-1.5 w-full overflow-hidden rounded-full bg-paper-3">
            <div
              class="h-full rounded-full bg-ink/30"
              style={`width: ${r.pct.toFixed(1)}%`}
              title={`${r.pct.toFixed(1)}% of the runs this rung was handed`}
              aria-hidden="true"
            />
          </div>
          <div class="flex items-baseline justify-between gap-2">
            <p class="mt-2 text-xs tabular-nums text-ink-2">{r.stat}</p>
            <span class="mt-2 shrink-0 font-serif text-sm font-bold tabular-nums text-ink">
              {r.pct.toFixed(1)}%
            </span>
          </div>
        </div>
      </li>
    ))
  }
</ol>
