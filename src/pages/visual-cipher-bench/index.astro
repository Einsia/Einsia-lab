---
/**
 * Visual Cipher Bench — project page, in the shape of SWE Refactor Bench: the
 * question and headline numbers, the puzzles themselves drifting past, what the
 * benchmark asks, one leaderboard, the one finding that explains it, and how
 * attempts are scored. Each section carries one figure and as little prose as
 * it needs. Numbers come from the paper (Table 1, Table 2) via results.ts.
 */
import Layout from '@/layouts/Layout.astro';
import Link from '@/components/ui/link.astro';
import { projectPath } from '@/lib/project-paths';
import { paperUrl } from '@/lib/visual-cipher-bench-assets';
import { categories } from '@/data/visual-cipher-bench/results';
import PuzzleMarquee from '@/components/visual-cipher-bench/PuzzleMarquee.astro';
import Leaderboard from '@/components/visual-cipher-bench/Leaderboard.astro';

const repo = 'https://github.com/Einsia/Visual-Cipher-Bench';
const description = 'Can coding agents discover the rules hidden in images? On 40 original visual puzzles, the best model solves 26.7%.';

const headline = [
  { v: '40', k: 'original visual puzzles' },
  { v: '29', k: 'configurations of 8 models' },
  { v: '26.7%', k: 'best accuracy, GPT-6 Astra' },
  { v: '3,480', k: 'graded runs, 3 per task' },
];

// One shared 0–60% scale, so the category bars and the hint bars compare directly.
const scaleMax = 60;
const bar = (v: number) => `${(v / scaleMax) * 100}%`;
const hint = [
  { k: 'No hint', v: 7.8 },
  { k: 'Mechanism hint', v: 55.6 },
];

// Paper §2.1 and Appendix A; the same for every configuration.
const setup = [
  { k: 'Input', v: 'One to three fixed drawings and the same short instruction' },
  { k: 'Environment', v: 'Offline container: 2 CPUs, 4 GB memory, no GPU, no internet' },
  { k: 'Time limit', v: '60 minutes per attempt' },
  { k: 'Feedback', v: 'None while solving' },
  { k: 'Scoring', v: 'Exact match on the submitted answer.txt by a separate verifier' },
  { k: 'Failures', v: 'Timeouts and invalid answers score zero' },
  { k: 'Runs', v: '3 per task × 40 tasks × 29 configurations = 3,480' },
];

const citation = `@article{hong2026visualcipherbench,
  title   = {Visual Cipher Bench: Benchmarking LLM Agents on Long-Horizon Visual Reasoning},
  author  = {Deyao Hong and Jiayi Jiang and Yuchun Chen and Yixuan Shi and Wenyi Li
             and Zheng Jiang and Chengxing Xie and Mingyu Su and Qingle Liu and Mingju Gao
             and Yizhe Chi and Youjie Zheng and Calvin Xiao and Kaisen Yang
             and Huan-ang Gao},
  journal = {arXiv preprint arXiv:2611.16861},
  year    = {2026}
}`;
---

<Layout title="Visual Cipher Bench" description={description}>
  <article class="max-w-4xl mx-auto px-5 sm:px-6">
    <header class="pt-16 md:pt-20">
      <a href={projectPath('/research')} class="inline-block text-xs font-semibold tracking-[0.08em] text-ink-3 hover:text-ink transition">← Research</a>
      <h1 class="mt-2 font-serif text-4xl sm:text-5xl md:text-6xl break-words font-bold tracking-tight text-ink leading-[1.05]">Visual Cipher Bench</h1>
      <p class="mt-5 text-lg md:text-xl text-ink-2 leading-relaxed max-w-2xl">
        Can a coding agent discover the rules hidden in an image, and reason all the way to an answer?
      </p>
      <p class="mt-4 text-sm text-ink-3">Navers Lab · Einsia.AI · Tsinghua University · 2026</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <Link href={paperUrl} size="md" style="primary" target="_blank" rel="noopener">arXiv</Link>
        <Link href={repo} size="md" style="outline" target="_blank" rel="noopener">GitHub</Link>
        <Link href="#leaderboard" size="md" style="outline">Leaderboard</Link>
        <Link href="#tasks" size="md" style="outline">Tasks</Link>
      </div>

      <dl class="mt-9 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-4">
        {headline.map(h => (
          <div class="bg-paper-white px-4 py-4">
            <dt class="font-serif text-2xl font-bold leading-none tabular-nums text-ink">{h.v}</dt>
            <dd class="mt-2 text-sm leading-snug text-ink-3">{h.k}</dd>
          </div>
        ))}
      </dl>
    </header>

    <section id="tasks" class="mt-10 scroll-mt-24" aria-label="The puzzles">
      <PuzzleMarquee />
    </section>

    <hr class="mt-12 border-line" />

    <section class="mt-12">
      <h2 class="font-serif text-3xl font-bold text-ink">Overview</h2>
      <p class="mt-4 text-base md:text-lg text-ink-2 leading-relaxed">
        Coding agents usually work from a written spec and a test suite. Here each task is just one to three
        black-and-white drawings and an instruction to submit an answer, so the agent has to work out the
        rule itself and carry it through to a final answer. The 40 puzzles cover four categories: spatial
        manipulation, logic and planning, rule induction, and knowledge-based decoding.
      </p>
      <figure class="mt-7">
        <img
          src={projectPath('/visual-cipher-bench/overview.webp')}
          alt="Visual Cipher Bench overview: four categories of ten puzzles, best reported model configurations, and the offline agent evaluation workflow"
          width="2000"
          height="900"
          loading="lazy"
          class="w-full rounded-xl border border-line bg-white"
        />
      </figure>
    </section>

    <section id="leaderboard" class="mt-14 scroll-mt-24">
      <h2 class="font-serif text-3xl font-bold text-ink">Leaderboard</h2>
      <p class="mt-4 text-base md:text-lg text-ink-2 leading-relaxed">
        Eight models at one or more reasoning-effort levels make 29 configurations. GPT-6 Astra at
        max effort leads at 26.7%, with GPT-6.1 Sol and Claude Opus 5.5 at 21.7%; the other five models
        stay below 1%.
      </p>
      <Leaderboard class="mt-7" />
      <a href={projectPath('/visual-cipher-bench/results.csv')} download class="mt-4 inline-block text-sm font-medium text-accent hover:underline underline-offset-4">
        All 29 configurations by category (CSV) <span aria-hidden="true">↓</span>
      </a>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-3xl font-bold text-ink">Key findings</h2>
      <p class="mt-4 text-base md:text-lg text-ink-2 leading-relaxed">
        Accuracy drops sharply once the rule has to be discovered rather than applied: across all
        configurations, spatial puzzles reach 22.8% and rule induction only 0.6%. On ten tasks, one sentence
        naming the mechanism, without intermediate steps or the answer, lifts accuracy from 7.8% to 55.6%.
      </p>
      <figure class="mt-7 grid gap-8 rounded-xl border border-line bg-paper-white px-5 py-6 sm:px-6 md:grid-cols-2 md:gap-10">
        <div>
          <p class="font-serif text-lg font-bold text-ink">Accuracy by category</p>
          <div class="mt-4 space-y-3">
            {categories.map(c => (
              <div class="grid grid-cols-[7.5rem_1fr_3.5rem] items-center gap-3 text-base">
                <span class="text-ink-2">{c.label}</span>
                <span class="h-2.5 rounded-full bg-ink/[0.07]"><span class="block h-full rounded-full bg-ink/70" style={`width:${bar(c.pooled)}`} /></span>
                <span class="text-right font-semibold tabular-nums text-ink">{c.pooled}%</span>
              </div>
            ))}
          </div>
        </div>
        <div>
          <p class="font-serif text-lg font-bold text-ink">Effect of a mechanism hint (10 tasks)</p>
          <div class="mt-4 space-y-3">
            {hint.map((h, i) => (
              <div class="grid grid-cols-[7.5rem_1fr_3.5rem] items-center gap-3 text-base">
                <span class="text-ink-2">{h.k}</span>
                <span class="h-2.5 rounded-full bg-ink/[0.07]"><span class:list={['block h-full rounded-full', i ? 'bg-accent' : 'bg-ink/40']} style={`width:${bar(h.v)}`} /></span>
                <span class="text-right font-semibold tabular-nums text-ink">{h.v}%</span>
              </div>
            ))}
          </div>
        </div>
      </figure>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-3xl font-bold text-ink">Evaluation setup</h2>
      <p class="mt-4 text-base md:text-lg text-ink-2 leading-relaxed">
        Every configuration attempts every task three times under the same conditions. The agent may
        inspect the images and run code, but learns nothing about correctness until its answer is scored.
      </p>
      <dl class="mt-7 divide-y divide-line overflow-hidden rounded-xl border border-line bg-paper-white text-base">
        {setup.map(s => (
          <div class="grid gap-1 px-5 py-3.5 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="font-medium text-ink">{s.k}</dt>
            <dd class="text-ink-2">{s.v}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-3xl font-bold text-ink">Citation</h2>
      <pre class="mt-4 overflow-x-auto rounded-xl border border-line bg-paper-white p-5 text-sm leading-relaxed text-ink-2"><code>{citation}</code></pre>
    </section>

    <div class="mt-16 mb-24 pt-6 border-t border-line">
      <a href={projectPath('/research')} class="inline-flex items-center gap-1 text-sm text-accent hover:text-accent-hover transition">← Back to Research</a>
    </div>
  </article>
</Layout>
