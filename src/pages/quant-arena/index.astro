---
import Layout from "@/layouts/Layout.astro";
import HeroLinks from "@/components/quant-arena/HeroLinks.astro";
import NavChart from "@/components/quant-arena/NavChart.astro";
import DecileChart from "@/components/quant-arena/DecileChart.astro";
import StyleHeatmap from "@/components/quant-arena/StyleHeatmap.astro";
import {
  teaser,
  KEPLER_NOTE,
  KEPLER_COLOR,
  kepler,
  bestRows,
  marketArr,
  tracks,
  formatScore,
  formatPercent,
  formatSigned,
  formatNumber,
} from "@/lib/quant-arena.js";
import "@/styles/pptbench.css";
import "@/styles/quant-arena.css";

const best = bestRows.map((row) => row.iterative);
const topArr = Math.max(...best.map((row) => row.arr));
const losers = best.filter((row) => row.arr < 0).length;

const findings = [
  {
    title: "No model beats the market",
    body: `In the sealed 2024 test year, the equal-weight market returned ${formatPercent(marketArr)}. No model's best strategy kept pace: the strongest gained ${formatPercent(topArr)}, and ${losers} of the ${best.length} models lost money.`,
  },
  {
    title: "Ranking skill does not reach the portfolio",
    body: "Most models rank stocks better than chance, yet the stocks they rank highest, the ones the portfolio actually buys, earn less than those ranked just below. Average rank correlation says little about whether a strategy makes money.",
  },
  {
    title: "Some models learn to time the market",
    body: "After research feedback showed losses, the top-scoring model wrote a market-timing rule: hold cash whenever the market trends down. It sat out the February 2024 crash, with a drawdown of −1.7% against −29.6% for the market. Because it also missed much of the rebound, it still finished behind the market for the year.",
  },
];

const steps = [
  {
    index: "01",
    title: "Research",
    body: "The model studies 2022–2023 data and receives bounded feedback on the candidates it submits.",
  },
  {
    index: "02",
    title: "Commit",
    body: "It commits exactly one strategy. Nothing can be changed after this point.",
  },
  {
    index: "03",
    title: "Sealed assessment",
    body: "The committed strategy is assessed once on a sealed 2024 window, trading in a cash account.",
  },
];
---

<Layout
  title="Quant-Arena: Benchmarking LLM Agents for Quantitative Trading Research"
  description="Quant Arena evaluates whether LLMs can research, commit and hold up a quantitative trading strategy on a sealed out-of-sample year.">
  <article class="pptbench-page quant-arena-page max-w-5xl mx-auto px-5 sm:px-8">
    <header class="pptbench-hero pt-16 md:pt-20">
      <a
        href="/research"
        class="inline-block text-xs font-semibold tracking-[0.08em] text-ink-3 hover:text-ink transition"
        >← Research</a
      >
      <h1 class="mt-3 font-serif font-bold tracking-tight text-ink break-words">
        Quant-Arena:<span class="qa-title-rest">Benchmarking LLM Agents for Quantitative Trading Research</span>
      </h1>
      <p class="pptbench-subtitle mt-5">
        Can a language model research a trading strategy, commit to it, and
        have it hold up on a year it has never seen?
      </p>
      <p class="pptbench-meta mt-4 text-sm">LaPlace's Eye · Einsia AI · 2026</p>
      <HeroLinks />
    </header>

    <figure class="qa-figure qa-teaser mt-10" style={`aspect-ratio:${teaser.width} / ${teaser.height}`}>
      {teaser.src ? (
        <img src={teaser.src} width={teaser.width} height={teaser.height} alt={teaser.alt} />
      ) : (
        <div class="qa-teaser-placeholder" role="img" aria-label={teaser.placeholder}>
          <span>{teaser.placeholder}</span>
        </div>
      )}
    </figure>

    <section id="task" class="pptbench-section mt-12">
      <h2 class="font-serif text-3xl font-bold text-ink">The task</h2>
      <p class="mt-4 text-base md:text-lg text-ink-2 leading-relaxed">
        Each model acts as a quantitative researcher. It researches on
        2022–2023 with bounded feedback, commits one strategy, and is assessed
        once on a sealed 2024 window in a cash account. The score combines the
        research-window result (S<sub>in</sub>) with the sealed 2024 result
        (S<sub>out</sub>), weighted toward the out-of-sample year.
      </p>
      <ol class="qa-steps mt-7">
        {steps.map((step) => (
          <li class="qa-step">
            <span class="qa-step-index">{step.index}</span>
            <strong>{step.title}</strong>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
      <div class="qa-tracks mt-7">
        {tracks.map((track) => (
          <div class="qa-track">
            <h3>{track.name}</h3>
            <p>{track.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="findings" class="pptbench-section mt-14">
      <h2 class="font-serif text-3xl font-bold text-ink">Key findings</h2>
      <div class="pptbench-findings">
        {findings.map((finding) => (
          <article class="pptbench-finding">
            <h3>{finding.title}</h3>
            <p>{finding.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="leaderboard" class="pptbench-section mt-14">
      <h2 class="font-serif text-3xl font-bold text-ink">Leaderboard</h2>
      <p class="mt-4 text-base md:text-lg text-ink-2 leading-relaxed">
        Each model at its best-scoring configuration in each setting. The 2024
        columns describe the committed iterative strategy on the sealed year. The
        <a href="/quant-arena/leaderboard/" class="text-accent hover:underline underline-offset-4">full leaderboard</a>
        lists every configuration.
      </p>
      <div class="pptbench-table-wrap">
        <table class="pptbench-table qa-table qa-table-compact">
          <caption class="sr-only">Quant Arena leaderboard</caption>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Model</th>
              <th scope="col" class="qa-num">Iterative</th>
              <th scope="col" class="qa-num">One-shot</th>
              <th scope="col" class="qa-num">2024 ARR</th>
              <th scope="col" class="qa-num">Excess (pp)</th>
              <th scope="col" class="qa-num">Sharpe</th>
              <th scope="col" class="qa-num">MDD</th>
            </tr>
          </thead>
          <tbody>
            {bestRows.map((row, index) => (
              <tr class:list={[index === 0 && "pptbench-top-tier"]}>
                <td>{index + 1}</td>
                <td><span class="qa-dot" style={`background:${row.color}`} />{row.model}</td>
                <td class="qa-num qa-score">{formatScore(row.iterative.total)}</td>
                <td class="qa-num">{formatScore(row.oneshot.total)}</td>
                <td class="qa-num">{formatPercent(row.iterative.arr)}</td>
                <td class="qa-num">{formatSigned(row.iterative.excess)}</td>
                <td class="qa-num">{formatNumber(row.iterative.sharpe, 2)}</td>
                <td class="qa-num">{formatPercent(row.iterative.mdd)}</td>
              </tr>
            ))}
            <tr class="qa-reference">
              <td>—</td>
              <td><span class="qa-dot" style={`background:${KEPLER_COLOR}`} />Kepler-1 <span class="qa-tag">Einsia AI</span></td>
              <td class="qa-num qa-score" colspan="2">{formatScore(kepler.total)}</td>
              <td class="qa-num">{formatPercent(kepler.arr)}</td>
              <td class="qa-num">{formatSigned(kepler.excess)}</td>
              <td class="qa-num">{formatNumber(kepler.sharpe, 2)}</td>
              <td class="qa-num">{formatPercent(kepler.mdd)}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="pptbench-note mt-3 text-xs leading-relaxed">
        The equal-weight market returned {formatPercent(marketArr)} in 2024. {KEPLER_NOTE}
      </p>
    </section>

    <section id="signals" class="pptbench-section mt-14">
      <h2 class="font-serif text-3xl font-bold text-ink">Inside the strategies</h2>
      <p class="mt-4 text-base md:text-lg text-ink-2 leading-relaxed">
        Three views of the strategy each model committed at its best-scoring
        iterative configuration, all on the sealed 2024 window.
      </p>

      <figure class="qa-figure">
        <figcaption>2024 cash-account NAV</figcaption>
        <NavChart />
        <p class="qa-caption">
          Net asset value through 2024, starting from 1. No model beats the
          equal-weight market (dashed), and only four finish above their
          starting capital. GPT-6 Astra's flat start comes from its
          market-timing rule: it holds cash through the early-2024 decline.
        </p>
      </figure>

      <figure class="qa-figure">
        <figcaption>Return by signal decile</figcaption>
        <DecileChart />
        <p class="qa-caption">
          Mean return of the following period, in basis points, for stocks in
          each signal decile (1 = lowest signal, 10 = highest; the peak and the
          top decile are highlighted). For most models returns peak in the
          second or third decile and fall toward the top decile, where the
          portfolio buys, so a higher RankIC does not translate into portfolio
          return. GPT-6 Astra and GPT-5.6 Terra rise across deciles, and GPT-6
          Sol is roughly flat.
        </p>
      </figure>

      <figure class="qa-figure">
        <figcaption>Investment styles</figcaption>
        <StyleHeatmap />
        <p class="qa-caption">
          Average standardised style exposure of each strategy's holdings, where
          0 is the market. Most models tilt toward small caps, high
          book-to-price (B/P) and low volatility; Claude Opus 5.5 and DeepSeek
          V4.1 Flash lean toward higher volatility and turnover, and GPT-5.6
          Terra stays close to the market on every style.
        </p>
      </figure>
    </section>

    <div class="mt-16 mb-24 border-t border-line pt-6">
      <a
        href="/research"
        class="inline-flex items-center gap-1 text-sm text-accent hover:text-accent-hover transition">
        ← Back to Research
      </a>
    </div>
  </article>
</Layout>

<script>
  // Keep SVG chart text at the same on-screen size as the HTML chart labels.
  const svgs = document.querySelectorAll<SVGSVGElement>(".qa-svg");
  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) {
      const svg = entry.target as SVGSVGElement;
      const scale = entry.contentRect.width / svg.viewBox.baseVal.width;
      if (scale > 0) svg.style.setProperty("--qa-svg-scale", scale.toFixed(3));
    }
  });
  svgs.forEach((svg) => observer.observe(svg));
</script>
