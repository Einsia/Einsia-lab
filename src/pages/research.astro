---
import { getCollection } from "astro:content";
import fs from "node:fs";
import Layout from "@/layouts/Layout.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { getFormattedDate } from "@/utils/all";
import { projectPath } from "@/lib/project-paths";
import { teaserBanner as quantArenaBanner } from "@/lib/quant-arena-teaser.js";

// publishDate is a date without a time, so it parses to midnight UTC. Comparing it
// against `now` hides an entry dated today from anyone east of UTC until their
// morning; the day's grace below publishes it on its calendar day everywhere.
const DAY_MS = 24 * 60 * 60 * 1000;
const entries = await getCollection("blog", ({ data }) => {
  return !data.draft && data.publishDate.valueOf() < Date.now() + DAY_MS;
});

entries.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const isExternal = (href: string) => /^https?:\/\//.test(href);
const localHref = (href: string) => href.startsWith("/") ? projectPath(href) : href;
const hrefFor = (entry: (typeof entries)[number]) =>
  localHref(entry.data.url ?? `/research/${entry.slug}`);
// Quant-Arena keeps its teaser in one config shared with its overview page.
const bannerFor = (entry: (typeof entries)[number]) =>
  entry.slug === "quant-arena" ? quantArenaBanner : entry.data.banner;
type Thumbnail = { src: string; width: number; height: number };
// Generated before dev/build from the original figures, including local WorkflowArena resources.
const thumbnails: Record<string, Thumbnail[]> = JSON.parse(
  fs.readFileSync('public/research/thumbnails/manifest.json', 'utf8')
);
---

<Layout
  title="Research"
  description="Benchmarks, papers, and releases from Navers lab.">
  <div class="lab-container">
    <Sectionhead align="left">
      <Fragment slot="title">Research</Fragment>
      <Fragment slot="desc">
        Benchmarks, papers, releases, and other lab updates — one place to track
        how the frontier moves.
      </Fragment>
    </Sectionhead>

    <div class="lab-research-list">
      <ul>
        {
          entries.map((entry, index) => {
            const href = hrefFor(entry);
            const banner = bannerFor(entry);
            const variants = banner ? thumbnails[banner.src] : undefined;
            if (banner && !variants?.length) throw new Error(`Run npm run build:research-images for ${banner.src}`);
            const image = variants?.find(image => image.width >= 480) || variants?.at(-1);
            const ext = isExternal(href)
              ? { target: "_blank", rel: "noopener" }
              : {};
            return (
              <li class="lab-research-row">
                  {banner && image && (
                    <a
                      href={href}
                       class="lab-research-thumbnail"
                        {...ext}
                       aria-label={entry.data.title}>
                        <img
                          src={localHref(image.src)}
                          srcset={variants!.map(image => `${localHref(image.src)} ${image.width}w`).join(', ')}
                          sizes="(min-width: 768px) 214px, calc(100vw - 66px)"
                          width={image.width}
                          height={image.height}
                          alt={banner.alt}
                          loading={index === 0 ? 'eager' : 'lazy'}
                          fetchpriority={index === 0 ? 'high' : undefined}
                          decoding="async"
                        />
                        <span class="lab-thumbnail-fallback" hidden>Preview unavailable</span>
                    </a>
                  )}

                  <div class="min-w-0">
                    <div class="lab-research-meta"><span>
                      {entry.data.category}
                    </span><time datetime={entry.data.publishDate.toISOString()}>{getFormattedDate(entry.data.publishDate)}</time></div>
                    <h2>
                      <a
                        href={href}
                        {...ext}
                        class="hover:underline underline-offset-4 decoration-1">
                        {entry.data.title}
                      </a>
                    </h2>
                    <p class="text-base text-ink-2 leading-relaxed">
                      {entry.data.snippet}
                    </p>

                    <div class="lab-research-links">
                      <a
                        href={href}
                        {...ext}
                        class="inline-flex items-center gap-1 font-medium text-accent hover:underline underline-offset-4">
                        Open
                        <span aria-hidden="true">→</span>
                      </a>
                      {entry.data.links.map((link) => (
                        <>
                          {link.pending ? (
                            <span
                              aria-disabled="true"
                              aria-label={`${link.label} — coming soon`}
                              title={`${link.label} link forthcoming`}
                              class="text-ink-3 cursor-default">
                              {link.label} · Forthcoming
                            </span>
                          ) : (
                          <a
                            href={localHref(link.href!)}
                            {...(isExternal(link.href!)
                              ? { target: "_blank", rel: "noopener" }
                              : {})}
                            class="text-accent hover:text-accent-hover hover:underline underline-offset-4 transition">
                            {link.label}
                          </a>
                          )}
                        </>
                      ))}
                    </div>
                  </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
  <script>
    document.querySelectorAll<HTMLImageElement>('.lab-research-thumbnail img').forEach(image => {
      const fallback = image.parentElement!.querySelector<HTMLElement>('.lab-thumbnail-fallback')!;
      const update = () => {
        const failed = image.complete && image.naturalWidth === 0;
        image.hidden = failed;
        fallback.hidden = !failed;
      };
      image.addEventListener('load', update);
      image.addEventListener('error', update);
      if (image.complete) update();
    });
  </script>
</Layout>
