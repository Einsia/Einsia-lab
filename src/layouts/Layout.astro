---
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import { projectPath } from "@/lib/project-paths";
import {
  getLabSeo,
  getLabStructuredData,
  LAB_SITE_NAME,
  LAB_SITE_URL,
  type LabSeo,
} from "@/lib/seo";
import DesignAssets from '@/components/DesignAssets.astro';
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  projectHeader?: boolean;
}

const { title, description = "Navers Lab - Einsia — Frontier AI Research", projectHeader = false } =
  Astro.props;

const configuredSeo = getLabSeo(Astro.url.pathname);
const fallbackTitle = title
  ? `${title} | ${LAB_SITE_NAME}`
  : LAB_SITE_NAME;
const seo: LabSeo = configuredSeo ?? {
  title: fallbackTitle,
  ogTitle: title || LAB_SITE_NAME,
  description,
  canonical: new URL(Astro.url.pathname, Astro.site).toString(),
  image: `${LAB_SITE_URL}/og/home.png`,
  imageAlt: "Navers Lab - Einsia frontier AI agent research",
  ogType: "website",
  schemaTypes: ["WebPage"],
};
const structuredData = getLabStructuredData(seo);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4efe4" />
    <link rel="icon" type="image/svg+xml" href={projectPath('/favicon.svg')} />
    <link rel="sitemap" href={projectPath('/sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <link rel="canonical" href={seo.canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={seo.ogType} />
    <meta property="og:site_name" content={LAB_SITE_NAME} />
    <meta property="og:title" content={seo.ogTitle} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.ogTitle} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />
    <meta name="twitter:image:alt" content={seo.imageAlt} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <DesignAssets />
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="lab-skip" href="#main-content">Skip to content</a>
    {!projectHeader && <Navbar />}
    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <dialog id="lightbox" class="lab-lightbox" aria-label="Figure preview">
      <button type="button" data-lightbox-close aria-label="Close figure preview">Close ×</button>
      <img id="lightbox-img" alt="" />
    </dialog>

    <style is:global>
      img {
        content-visibility: auto;
      }
    </style>

    <script>
      (function () {
        const box = document.getElementById("lightbox") as HTMLDialogElement | null;
        const boxImg = document.getElementById(
          "lightbox-img"
        ) as HTMLImageElement | null;
        if (!box || !boxImg) return;

        const open = (src: string, alt: string) => {
          boxImg.src = src;
          boxImg.alt = alt;
          box.showModal();
        };
        const close = () => {
          box.close();
        };

        document.querySelectorAll<HTMLImageElement>("main img").forEach((img) => {
          if (img.closest("a, button, [data-no-lightbox], [role=button]")) return;
          img.style.cursor = "zoom-in";
          img.tabIndex = 0;
          img.setAttribute('role', 'button');
          img.setAttribute('aria-haspopup', 'dialog');
          img.setAttribute('aria-label', `Enlarge figure: ${img.alt || 'Research image'}`);
          img.addEventListener("click", () =>
            open(img.currentSrc || img.src, img.alt)
          );
          img.addEventListener('keydown', event => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault(); open(img.currentSrc || img.src, img.alt);
            }
          });
        });

        box.querySelector('[data-lightbox-close]')?.addEventListener('click', close);
        box.addEventListener('click', event => { if (event.target === box) close(); });
        box.addEventListener('close', () => boxImg.removeAttribute('src'));
      })();
    </script>
  </body>
</html>
