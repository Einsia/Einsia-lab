---
import { projectPath } from '@/lib/project-paths';
const asset = (file: string) => projectPath(`/frontier3d/${file}`);
const examples = [
  { id: 'object', title: 'Reference to object', name: 'Blender', level: 'L1', file: 'Typewriter.blend', reference: 'typewriter-reference.webp', referenceAlt: 'Original typewriter task reference', image: 'media/typewriter-astra.jpg', result: 'Generated typewriter object' },
  { id: 'scene', title: 'Reference to scene', name: 'Blender', level: 'L2', file: 'Museum.blend', reference: 'museum-reference.webp', referenceAlt: 'Original museum hall task reference', image: 'media/museum-astra.jpg', result: 'Generated museum hall scene' },
  { id: 'environment', title: 'Reference to environment', name: 'Unreal Engine 5', level: 'L3', file: 'Workshop.uproject', reference: 'workshop-reference.webp', referenceAlt: 'Original interactive workshop task reference', image: 'workflow/workshop-generated.webp', result: 'Generated interactive workshop environment' },
];
---
<div class="evidence-workflows" aria-label="Reference images and generated 3D assets">
  {examples.map(e => <section aria-labelledby={`wf-${e.id}-title`}>
    <h3 id={`wf-${e.id}-title`}><span>{e.level}</span> {e.title}</h3>
    <p>A coding agent builds an editable {e.name} project: <code>{e.file}</code>.</p>
    <div class="evidence-pair">
      <figure><img src={asset(`workflow/${e.reference}`)} alt={e.referenceAlt} width="800" height="560" loading="lazy" /><figcaption>Input · Reference image</figcaption></figure>
      <figure><img src={asset(e.image)} alt={e.result} width="512" height="320" loading="lazy" /><figcaption>Output · {e.result}</figcaption></figure>
    </div>
  </section>)}
</div>
<style>
  .evidence-workflows { display: grid; gap: var(--lab-space-10); }
  section { border-top: 1px solid var(--lab-border); padding-top: var(--lab-space-6); }
  h3 { font-size: var(--lab-h3); line-height: var(--lab-h3-leading); margin: 0 0 var(--lab-space-4); }
  h3 span { font: 600 var(--lab-ui)/var(--lab-ui-leading) var(--lab-font-sans); color: var(--lab-muted); margin-right: var(--lab-space-2); }
  p { margin: 0 0 var(--lab-space-6); color: var(--lab-muted); }
  .evidence-pair { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--lab-space-6); }
  figure { margin: 0; }
  img { width: 100%; height: auto; aspect-ratio: 8/5; object-fit: contain; background: var(--lab-surface); border-radius: var(--lab-radius-panel); }
  figcaption { margin-top: var(--lab-space-3); }
  @media (max-width: 767px) { .evidence-pair { grid-template-columns: minmax(0,1fr); } }
</style>
