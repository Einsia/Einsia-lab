---
import Layout from "@/layouts/Layout.astro";
import HeroLinks from "@/components/quant-arena/HeroLinks.astro";
import EffortBars from "@/components/quant-arena/EffortBars.astro";
import {
  KEPLER_NOTE,
  KEPLER_COLOR,
  kepler,
  modelRows,
  tracks,
  groupsFor,
  effortOrder,
  effortOpacity,
  formatScore,
  formatPercent,
  formatSigned,
  formatNumber,
} from "@/lib/quant-arena.js";
import "@/styles/pptbench.css";
import "@/styles/quant-arena.css";

const boards = tracks.map((track) => ({ ...track, groups: groupsFor(track.id) }));
---

<Layout
  title="Quant Arena leaderboard"
  description="The complete Quant Arena leaderboard: every model at every reasoning effort, for iterative research and one-shot generation.">
  <article class="pptbench-page quant-arena-page max-w-5xl mx-auto px-5 sm:px-8">
    <header class="pptbench-hero pt-16 md:pt-20">
      <a
        href="/quant-arena/"
        class="inline-block text-xs font-semibold tracking-[0.08em] text-ink-3 hover:text-ink transition"
        >← Quant Arena</a
      >
      <h1 class="mt-3 font-serif text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-ink">
        The leaderboard
      </h1>
      <p class="pptbench-subtitle mt-5">
        Every model at every reasoning effort ({modelRows.length} cells), in
        both settings, with the research-window and sealed 2024 scores and the
        2024 portfolio metrics kept together.
      </p>
      <HeroLinks />
    </header>

    <hr class="mt-12 border-line" />

    <section class="pptbench-section mt-12" aria-labelledby="chart-heading">
      <h2 id="chart-heading" class="font-serif text-3xl font-bold text-ink">Total score by reasoning effort</h2>
      <p class="mt-4 text-base md:text-lg text-ink-2 leading-relaxed">
        One bar per model and effort, with Kepler-1 as the reference line.
        Higher effort does not reliably raise the score: several models do
        best at low or medium effort, in both settings.
      </p>
      {boards.map((board) => (
        <figure>
          <div class="pptbench-chart-meta">
            <span><strong class="qa-panel-title">{board.name}</strong> · total score out of 100</span>
            <span class="pptbench-effort-legend" aria-label="Reasoning effort: less effort to more effort">
              <span class="pptbench-effort-legend-label">less effort</span>
              <span class="pptbench-effort-swatches" aria-hidden="true">
                {effortOrder.map((effort) => (
                  <span class="pptbench-effort-swatch" style={`--effort-opacity:${effortOpacity[effort]}`} title={effort} />
                ))}
              </span>
              <span class="pptbench-effort-legend-label">more</span>
            </span>
          </div>
          <EffortBars track={board.id} label={board.name} />
        </figure>
      ))}
    </section>

    {boards.map((board) => (
      <section id={board.id} class="pptbench-section mt-14" aria-labelledby={`${board.id}-heading`}>
        <h2 id={`${board.id}-heading`} class="font-serif text-3xl font-bold text-ink">{board.name}</h2>
        <p class="mt-3 text-base text-ink-2 leading-relaxed">{board.description}</p>
        <div class="pptbench-table-wrap">
          <table class="pptbench-table qa-table">
            <caption class="sr-only">Quant Arena {board.name} leaderboard</caption>
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Model</th>
                <th scope="col">Effort</th>
                <th scope="col" class="qa-num">Total</th>
                <th scope="col" class="qa-num">S<sub>in</sub></th>
                <th scope="col" class="qa-num">S<sub>out</sub></th>
                <th scope="col" class="qa-num">2024 ARR</th>
                <th scope="col" class="qa-num">Excess</th>
                <th scope="col" class="qa-num">RankIC</th>
                <th scope="col" class="qa-num">Sharpe</th>
                <th scope="col" class="qa-num">MDD</th>
              </tr>
            </thead>
            <tbody>
              <tr class="qa-reference">
                <td>—</td>
                <td><span class="qa-dot" style={`background:${KEPLER_COLOR}`} />Kepler-1 <span class="qa-tag">Einsia AI</span></td>
                <td>—</td>
                <td class="qa-num qa-score">{formatScore(kepler.total)}</td>
                <td class="qa-num">{formatScore(kepler.sIn)}</td>
                <td class="qa-num">{formatScore(kepler.sOut)}</td>
                <td class="qa-num">{formatPercent(kepler.arr)}</td>
                <td class="qa-num">{formatSigned(kepler.excess)}</td>
                <td class="qa-num">{formatNumber(kepler.rankIc, 3)}</td>
                <td class="qa-num">{formatNumber(kepler.sharpe, 2)}</td>
                <td class="qa-num">{formatPercent(kepler.mdd)}</td>
              </tr>
              {board.groups.map((group, groupIndex) =>
                group.rows.map((row, rowIndex) => (
                  <tr
                    class:list={[
                      rowIndex === 0 && "qa-group-start",
                      row.total === group.best && "qa-group-best",
                      groupIndex === 0 && "pptbench-top-tier",
                    ]}>
                    <td>{rowIndex === 0 ? groupIndex + 1 : ""}</td>
                    <td>
                      {rowIndex === 0 ? (
                        <>
                          <span class="qa-dot" style={`background:${group.color}`} />
                          {group.model}
                        </>
                      ) : (
                        <span class="sr-only">{group.model}</span>
                      )}
                    </td>
                    <td>
                      <span class="qa-effort">
                        <span
                          class="qa-effort-swatch"
                          style={`background:${group.color};opacity:${effortOpacity[row.effort]}`}
                          aria-hidden="true"
                        />
                        {row.effort}
                      </span>
                    </td>
                    <td class="qa-num qa-score">{formatScore(row.total)}</td>
                    <td class="qa-num">{formatScore(row.sIn)}</td>
                    <td class="qa-num">{formatScore(row.sOut)}</td>
                    <td class="qa-num">{formatPercent(row.arr)}</td>
                    <td class="qa-num">{formatSigned(row.excess)}</td>
                    <td class="qa-num">{formatNumber(row.rankIc, 3)}</td>
                    <td class="qa-num">{formatNumber(row.sharpe, 2)}</td>
                    <td class="qa-num">{formatPercent(row.mdd)}</td>
                  </tr>
                )),
              )}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <section class="pptbench-section mt-14" aria-labelledby="columns-heading">
      <h2 id="columns-heading" class="font-serif text-3xl font-bold text-ink">Reading the tables</h2>
      <dl class="qa-legend mt-5">
        <div><dt>Total</dt><dd>Overall score, combining S<sub>in</sub> and S<sub>out</sub> and weighted toward S<sub>out</sub>.</dd></div>
        <div><dt>S<sub>in</sub></dt><dd>Score on the 2022–2023 research window.</dd></div>
        <div><dt>S<sub>out</sub></dt><dd>Score on the sealed 2024 window.</dd></div>
        <div><dt>2024 metrics</dt><dd>Annualised return, excess over the equal-weight market (pp), RankIC, Sharpe ratio and maximum drawdown, cash account.</dd></div>
      </dl>
      <p class="pptbench-note mt-5 text-xs leading-relaxed">
        Models are ordered by their best effort, and rows run from less to more
        effort. Bold marks each model's best effort. Not every model exposes
        every effort level. {KEPLER_NOTE}
      </p>
    </section>

    <div class="mt-16 mb-24 border-t border-line pt-6">
      <a href="/quant-arena/" class="inline-flex items-center gap-1 text-sm text-accent hover:text-accent-hover transition">
        ← Back to Quant Arena
      </a>
    </div>
  </article>
</Layout>
