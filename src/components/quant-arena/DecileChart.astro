---
/**
 * Mean return of the following period (bp) by signal decile, one small
 * panel per model on a shared scale; decile 10 is the highest signal.
 */
import { signalDeciles, familyColor, maxEffortRows } from "@/lib/quant-arena.js";

const order = maxEffortRows.map((row) => row.model);
const panels = [...signalDeciles].sort((a, b) => order.indexOf(a.model) - order.indexOf(b.model));
const values = panels.flatMap((p) => p.deciles);
const top = Math.ceil(Math.max(...values, 0) / 10) * 10;
const bottom = Math.floor(Math.min(...values, 0) / 10) * 10;
const W = 220;
const H = 120;
const plot = { left: 26, right: 4, top: 8, bottom: 16 };
const plotW = W - plot.left - plot.right;
const plotH = H - plot.top - plot.bottom;
const y = (v: number) => plot.top + ((top - v) / (top - bottom)) * plotH;
const slot = plotW / 10;
const ticks = [bottom, 0, top].filter((v, i, a) => a.indexOf(v) === i);
const fmt = (v: number) => (v > 0 ? "+" : "") + v.toFixed(1).replace("-", "−");
---

<div class="qa-deciles">
  {panels.map((panel) => {
    const peak = panel.deciles.indexOf(Math.max(...panel.deciles));
    return (
      <div class="qa-decile-panel">
        <div class="qa-decile-head">
          <span><span class="qa-dot" style={`background:${familyColor[panel.model]}`} />{panel.model}</span>
          <span class="qa-decile-stats">RankIC {panel.rankIc.toFixed(3)} · H−L {fmt(panel.topMinusBottom)} bp</span>
        </div>
        <svg class="qa-svg" style="--qa-svg-scale:1.35" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${panel.model}: mean return by signal decile, from ${panel.deciles[0]} bp (decile 1) to ${panel.deciles[9]} bp (decile 10)`}>
          {ticks.map((t) => (
            <g>
              <line class={t === 0 ? "qa-svg-baseline" : "pptbench-chart-grid"} x1={plot.left} x2={W - plot.right} y1={y(t)} y2={y(t)} />
              <text class="pptbench-chart-label" x={plot.left - 4} y={y(t) + 3.5} text-anchor="end">{t}</text>
            </g>
          ))}
          {panel.deciles.map((v, i) => (
            <rect
              x={plot.left + i * slot + slot * 0.15}
              width={slot * 0.7}
              y={Math.min(y(v), y(0))}
              height={Math.max(0.8, Math.abs(y(v) - y(0)))}
              rx="1.5"
              fill={familyColor[panel.model]}
              opacity={i === peak || i === 9 ? 1 : 0.45}>
              <title>Decile {i + 1}: {v.toFixed(1)} bp</title>
            </rect>
          ))}
          <text class="pptbench-chart-label" x={plot.left + slot / 2} y={H - 3} text-anchor="middle">1</text>
          <text class="pptbench-chart-label" x={plot.left + 9.5 * slot} y={H - 3} text-anchor="middle">10</text>
        </svg>
      </div>
    );
  })}
</div>
