---
/**
 * Mean composite against reasoning effort, one line per swept system.
 *
 * Drawn rather than tabulated because the shape is the finding: the lines are
 * not monotone. Every system here has a setting above which paying for more
 * reasoning buys less, and on a table that reads as a row of numbers where one
 * happens to be biggest. As lines it reads as a peak, and the peaks do not land
 * on the same level.
 *
 * The x axis is categorical — the levels are an ordered interface, not a
 * quantity, and the gap between `high` and `xhigh` is not a gap of any known
 * size. Levels a system does not expose leave its line undrawn there rather
 * than interpolated across.
 */
interface Cell {
  effort: string;
  missing?: boolean;
  score?: number;
  accepted?: number;
  gate?: number;
  n?: number;
}
interface Row {
  model: string;
  cells: Cell[];
  overall: { score: number };
}
interface Props {
  levels: string[];
  rows: Row[];
  class?: string;
}
const { levels, rows, class: className } = Astro.props;

const W = 860;
const H = 380;
const M = { top: 28, right: 104, bottom: 46, left: 40 };
const IW = W - M.left - M.right;
const IH = H - M.top - M.bottom;

const present = levels.filter((l) => rows.some((r) => !r.cells.find((c) => c.effort === l)?.missing));
const x = (effort: string) => {
  const i = present.indexOf(effort);
  return M.left + (present.length === 1 ? IW / 2 : (i / (present.length - 1)) * IW);
};

const scores = rows.flatMap((r) => r.cells.filter((c) => !c.missing).map((c) => c.score!));
const yMax = Math.ceil(Math.max(...scores) / 10) * 10;
const yTicks = Array.from({ length: yMax / 10 + 1 }, (_, i) => i * 10);
const y = (v: number) => M.top + IH - (v / yMax) * IH;

// Ink weight ranks the systems, so the strongest line is the darkest and reads
// first without needing a hue.
const lines = rows.map((r, i) => {
  const pts = r.cells
    .filter((c) => !c.missing)
    .map((c) => ({ ...c, x: x(c.effort), y: y(c.score!) }));
  const peak = pts.reduce((a, b) => (b.score! > a.score! ? b : a), pts[0]);
  return {
    ...r,
    pts,
    peak,
    d: pts.map((p, j) => `${j ? "L" : "M"}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(" "),
    ink: [0.9, 0.6, 0.38, 0.24][i] ?? 0.18,
    last: pts[pts.length - 1],
  };
});

// End labels, pushed apart so two systems finishing at the same score stay legible.
const labels = [...lines].sort((a, b) => a.last.y - b.last.y).map((l) => ({ l, ly: l.last.y }));
for (let i = 1; i < labels.length; i++) {
  if (labels[i].ly - labels[i - 1].ly < 13) labels[i].ly = labels[i - 1].ly + 13;
}
---

<figure class:list={[className]}>
  <div class="rounded-xl border border-line bg-paper-white p-2 sm:p-3">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      width="100%"
      role="img"
      aria-label={`Mean composite against reasoning effort for ${rows.length} systems`}
      style="display:block">
      {
        yTicks.map((t) => (
          <g>
            <line
              x1={M.left}
              x2={W - M.right}
              y1={y(t)}
              y2={y(t)}
              stroke="var(--color-ink)"
              opacity={t === 0 ? 0.18 : 0.07}
            />
            <text
              x={M.left - 8}
              y={y(t) + 4}
              text-anchor="end"
              font-size="11"
              fill="var(--color-ink-3)"
              class="tabular-nums">
              {t}
            </text>
          </g>
        ))
      }
      <text x={M.left} y={M.top - 11} font-size="12" font-weight="600" fill="var(--color-ink-2)">
        Mean composite
      </text>

      {
        present.map((l) => (
          <g>
            <line
              x1={x(l)}
              x2={x(l)}
              y1={M.top}
              y2={M.top + IH}
              stroke="var(--color-ink)"
              opacity="0.06"
            />
            <text
              x={x(l)}
              y={M.top + IH + 18}
              text-anchor="middle"
              font-size="11"
              fill="var(--color-ink-3)"
              class="font-mono">
              {l}
            </text>
          </g>
        ))
      }
      <text
        x={M.left + IW / 2}
        y={H - 8}
        text-anchor="middle"
        font-size="11"
        fill="var(--color-ink-4)">
        Reasoning effort, as the interface exposes it
      </text>

      {
        lines.map((l) => (
          <g>
            <path
              d={l.d}
              fill="none"
              stroke="var(--color-ink)"
              stroke-opacity={l.ink}
              stroke-width="1.6"
              stroke-linejoin="round"
              stroke-linecap="round"
            />
            {l.pts.map((p) => (
              <g>
                <title>
                  {l.model} [{p.effort}] — mean composite {p.score!.toFixed(2)}, {p.accepted}{" "}
                  accepted of {p.n}
                </title>
                <circle cx={p.x} cy={p.y} r="8" fill="transparent" />
                <circle
                  cx={p.x}
                  cy={p.y}
                  r={p === l.peak ? 4 : 2.8}
                  fill={p === l.peak ? "var(--color-ink)" : "var(--color-paper-white)"}
                  stroke="var(--color-ink)"
                  stroke-opacity={l.ink}
                  stroke-width={p === l.peak ? 0 : 1.3}
                />
              </g>
            ))}
          </g>
        ))
      }

      {
        labels.map(({ l, ly }) => (
          <g>
            <line
              x1={l.last.x + 6}
              x2={W - M.right + 6}
              y1={l.last.y}
              y2={ly}
              stroke="var(--color-ink)"
              stroke-opacity={Math.min(0.2, l.ink)}
            />
            <text
              x={W - M.right + 10}
              y={ly + 3.5}
              font-size="10.5"
              fill="var(--color-ink-2)"
              class="font-mono">
              {l.model}
            </text>
          </g>
        ))
      }
    </svg>
  </div>

  <figcaption class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-[0.68rem] text-ink-3">
    <span class="inline-flex items-center gap-1.5">
      <svg width="10" height="10" aria-hidden="true"
        ><circle cx="5" cy="5" r="4" fill="var(--color-ink)"></circle></svg
      >
      each system's peak level
    </span>
    <span>
      Peaks at
      {
        lines
          .map((l) => `${l.model} ${l.peak.effort}`)
          .join(", ")
          .replace(/, ([^,]*)$/, " and $1")
      }.
    </span>
  </figcaption>
</figure>
