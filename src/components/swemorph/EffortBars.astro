---
/**
 * The leaderboard as one bar per configuration.
 *
 * Every (system, reasoning effort) pair that was run gets its own bar — all 26
 * of them — grouped by system so the effort sweep reads as a shape rather than
 * as 26 unrelated rows. Bar length is the composite score; the chip on the right
 * is what one task cost, taken from the paper's table so the site and the paper
 * cannot drift apart.
 *
 * Colour carries the system, lightness carries the effort: inside a group the
 * bars go pale to saturated as effort rises, so "more effort, more score" would
 * read as a staircase getting darker to the right. Where it does not — opus at
 * max, sonnet after medium — the break is visible without a caption.
 */
import { hueOf, EFFORTS } from "@/lib/swemorph.js";
import { paperCost } from "@/lib/paperCost.js";

interface Props {
  configs: any[];
  class?: string;
}
const { configs, class: klass = "" } = Astro.props;

// The vendor mark for each system, from the same logo set the paper's figures
// use. They are single-path monochrome files, so the tile paints them with a
// CSS mask rather than an <img>: one glyph, recoloured to sit on the system's
// own hue.
const LOGO_HEX: Record<string, string> = {
  // Each brand's own colour, as published with the icon set these files come
  // from. OpenAI's mark has no colour of its own in that set and is used
  // monochrome on light backgrounds, so it stays black.
  claude: "#D97757",
  openai: "#000000",
  kimi: "#000000",
  qwen: "#6950EF",
  deepseek: "#5786FE",
  zdotai: "#2D2D2D",
};
const LOGOS: Record<string, string> = {
  "claude-opus-5": "claude",
  "claude-sonnet-5": "claude",
  "gpt-5.6-sol": "openai",
  "gpt-5.6-luna": "openai",
  "kimi-k3": "kimi",
  "qwen3.8-max": "qwen",
  "dsv4-flash": "deepseek",
  "glm-5.2": "zdotai",
};
const logoOf = (model: string) => LOGOS[model] ?? "claude";
const logoUrl = (model: string) => `/swe-morph-bench/img/logos/${logoOf(model)}.svg`;
const logoHex = (model: string) => LOGO_HEX[logoOf(model)] ?? "#1a1a1a";
const VENDOR: Record<string, string> = {
  "claude-opus-5": "Anthropic",
  "claude-sonnet-5": "Anthropic",
  "gpt-5.6-sol": "OpenAI",
  "gpt-5.6-luna": "OpenAI",
  "kimi-k3": "Moonshot",
  "qwen3.8-max": "Alibaba",
  "dsv4-flash": "DeepSeek",
  "glm-5.2": "Z.ai",
};

const rank = new Map(EFFORTS.map((e: string, i: number) => [e, i]));

// One group per system, ordered by the system's best score; bars inside a group
// follow the effort scale, not the score, so the sweep keeps its direction.
const groups = [...new Set(configs.map((c) => c.model))]
  .map((model) => {
    const rows = configs
      .filter((c) => c.model === model)
      .sort((a, b) => (rank.get(a.effort) ?? 99) - (rank.get(b.effort) ?? 99))
      .map((c) => ({ ...c, cost: paperCost(c.key) }));
    const best = Math.max(...rows.map((r) => r.score));
    return { model, hue: hueOf(model), rows, best, accepted: rows.reduce((a, r) => a + r.accepted, 0) };
  })
  .sort((a, b) => b.best - a.best);

// One scale for every bar in the figure, rounded up to a tick so the axis ends
// on a label. Scores are out of 100 but nothing clears 50, and a 0-100 axis
// would spend half the width on emptiness.
const top = Math.ceil(Math.max(...configs.map((c) => c.score)) / 10) * 10 + 10;
const ticks = Array.from({ length: top / 10 + 1 }, (_, i) => i * 10);
const pct = (v: number) => `${(v / top) * 100}%`;

// Lightness ramp inside a group: pale at `none`, full strength at `max`.
const strength = (effort: string, n: number, i: number) =>
  n === 1 ? 1 : 0.42 + 0.58 * (i / (n - 1));
---

<figure class:list={["swm-bars not-prose", klass]}>
  <!-- Axis -->
  <div class="mb-2 flex items-end justify-between text-[0.62rem] uppercase tracking-[0.09em] text-ink-3">
    <span>Score (out of 100)</span>
    <span>Cost per task</span>
  </div>

  <div class="relative rounded-xl border border-line bg-paper-white px-4 pb-3 pt-4 sm:px-5">
    <!-- Gridlines, drawn once behind every group -->
    <div class="pointer-events-none absolute inset-y-3 left-4 right-4 sm:left-5 sm:right-5" aria-hidden="true">
      <div
        class="relative h-full"
        style="margin-left:calc(var(--swm-label) + 0.5rem);margin-right:calc(var(--swm-cost) + 0.5rem)">
        {ticks.map((t) => (
          <span
            class="absolute top-0 bottom-0 border-l border-dashed border-ink/[0.07]"
            style={`left:${pct(t)}`}
          />
        ))}
      </div>
    </div>

    {groups.map((g, gi) => (
      <section class:list={["relative", gi > 0 && "mt-3.5 border-t border-line pt-3.5"]}>
        {/* System header: mark, name, vendor, and the best cell of the sweep */}
        <header class="mb-1.5 flex items-center gap-2.5">
          <span
            class="grid h-6 w-6 shrink-0 place-items-center rounded-[7px] border border-line bg-paper-white"
            aria-hidden="true">
            <span
              class="swm-logo"
              style={`background:${logoHex(g.model)};-webkit-mask-image:url(${logoUrl(g.model)});mask-image:url(${logoUrl(g.model)})`}
            />
          </span>
          <span class="font-mono text-[0.82rem] font-medium text-ink">{g.model}</span>
          <span class="text-[0.68rem] text-ink-4">{VENDOR[g.model]}</span>
          <span class="ml-auto text-[0.68rem] tabular-nums text-ink-3">
            best <span class="font-semibold text-ink">{g.best.toFixed(1)}</span>
            <span class="mx-1.5 text-ink-5">·</span>
            {g.accepted} accepted
          </span>
        </header>

        {g.rows.map((r, i) => (
          <div class="swm-row group flex items-center gap-2 py-[3px]">
            <span class="swm-label shrink-0 text-right font-mono text-[0.66rem] uppercase tracking-wide text-ink-3">
              {r.effort}
            </span>

            <div class="relative h-[18px] flex-1">
              <div
                class="swm-bar absolute inset-y-0 left-0 rounded-r-[4px] rounded-l-[2px]"
                style={`width:${pct(r.score)};--swm-hue:${g.hue};opacity:${strength(r.effort, g.rows.length, i)};animation-delay:${gi * 60 + i * 35}ms`}
              />
              <span
                class="absolute inset-y-0 flex items-center pl-1.5 text-[0.7rem] font-semibold tabular-nums text-ink"
                style={`left:${pct(r.score)}`}>
                {r.score.toFixed(1)}
              </span>
              {r.isBest && (
                <span
                  class="absolute -top-[3px] -bottom-[3px] w-px bg-ink/45"
                  style={`left:${pct(r.score)}`}
                  aria-hidden="true"
                />
              )}
            </div>

            <span class="swm-cost shrink-0 text-right">
              {r.cost == null ? (
                <span class="text-[0.68rem] text-ink-4">—</span>
              ) : (
                <span
                  class="inline-block rounded-md border border-line bg-paper-2 px-1.5 py-[1px] font-mono text-[0.66rem] tabular-nums text-ink-2">
                  ${r.cost.toFixed(1)}
                </span>
              )}
            </span>

            {/* Hover detail: the funnel behind the bar. Title attribute, so it
                works on a static page with no script. */}
            <span class="sr-only">
              {r.accepted} accepted, {r.broken} broken by a counterexample, {r.blind} blind, of {r.n} runs
            </span>
            <span
              class="pointer-events-none absolute inset-0"
              title={`${r.model} · ${r.effort} — score ${r.score.toFixed(1)}, ${r.accepted} accepted / ${r.broken} broken / ${r.blind} blind of ${r.n} runs${r.cost == null ? "" : `, $${r.cost.toFixed(1)} per task`}`}
            />
          </div>
        ))}
      </section>
    ))}

    <!-- Axis labels -->
    <div class="mt-2.5 flex" aria-hidden="true">
      <span class="swm-label shrink-0"></span>
      <div class="relative ml-2 mr-2 h-4 flex-1">
        {ticks.map((t) => (
          <span
            class="absolute top-0 -translate-x-1/2 text-[0.62rem] tabular-nums text-ink-4"
            style={`left:${pct(t)}`}>{t}</span>
        ))}
      </div>
      <span class="swm-cost shrink-0"></span>
    </div>
  </div>

  <figcaption class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[0.68rem] text-ink-3">
    <span>One bar per configuration, {configs.length} in all; 20 tasks each.</span>
    <span>Colour is the system, depth is the effort level.</span>
    <span>Cost is dollars of API spend for one task.</span>
  </figcaption>
</figure>

<style>
  .swm-bars {
    --swm-label: 3.1rem;
    --swm-cost: 3.4rem;
  }
  .swm-label {
    width: var(--swm-label);
  }
  .swm-cost {
    width: var(--swm-cost);
  }
  .swm-row {
    position: relative;
  }
  /* The vendor glyph. The files are single-path and colourless, so the mask
     paints them; the colour comes from the brand, set inline per row. */
  .swm-logo {
    display: block;
    width: 14px;
    height: 14px;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }
  .swm-bar {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--swm-hue) 62%, white) 0%,
      var(--swm-hue) 100%
    );
    transform-origin: left center;
    animation: swm-grow 0.62s cubic-bezier(0.22, 1, 0.36, 1) both;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
  }
  .swm-row:hover .swm-bar {
    filter: saturate(1.15) brightness(1.04);
  }
  @keyframes swm-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .swm-bar {
      animation: none;
    }
  }
</style>
