---
/** COGI standings as bars on the full 0-100 scale; baselines stay muted. */
import { baselines, models, score } from "@/lib/diabagent.js";

interface Props {
  /** Keep only the strongest baseline, for the overview page. */
  compact?: boolean;
}
const { compact = false } = Astro.props;

const rows = [
  ...models.map((m: any) => ({ name: m.name, value: m.score, color: m.color, kind: "model" })),
  ...baselines
    .slice(0, compact ? 1 : baselines.length)
    .map((b: any) => ({ name: b.name, value: b.score, color: "var(--color-ink-4)", kind: "baseline" })),
].sort((a, b) => b.value - a.value);
---

<ol class="da-bars" aria-label="COGI by controller">
  {
    rows.map((row) => (
      <li class:list={["da-bar", row.kind === "baseline" && "is-baseline"]}>
        <span class="da-bar-name">{row.name}</span>
        <span class="da-bar-track">
          <span class="da-bar-fill" style={`width:${row.value}%;background:${row.color}`} />
        </span>
        <span class="da-bar-value">{score(row.value)}</span>
      </li>
    ))
  }
</ol>
