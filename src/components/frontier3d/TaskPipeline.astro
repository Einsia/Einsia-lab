---
import { projectPath } from '@/lib/project-paths';
const asset = (file: string) => projectPath(`/frontier3d/${file}`);
const editors = [
  { name: 'Blender', levels: 'L1 & L2', file: 'Typewriter.blend', image: 'typewriter-astra.jpg', kind: 'blender', selected: 'Typewriter', objects: ['Camera', 'Typewriter', 'Keys', 'Carriage', 'Paper'], tabs: ['Layout', 'Modeling', 'Shading'], footer: 'Meshes · Materials · Modifiers' },
  { name: 'Unreal Engine 5', levels: 'L3', file: 'Village.uproject', image: 'minecraft-opus.jpg', kind: 'unreal', selected: 'BP_Door', objects: ['Landscape', 'Village', 'BP_Door', 'BP_Chest', 'DirectionalLight'], tabs: ['Select', 'Landscape', 'Blueprints'], footer: 'Levels · Blueprints · Assets' },
];
---
<div class="wf" aria-label="Reference image and prompt, or text instruction, to a coding agent, to editable Blender and Unreal Engine projects">
  <div class="wf-input">
    <div class="wf-label">INPUT</div>
    <div class="wf-reference">
      <div class="wf-photo"><img src={asset('workflow/typewriter-reference.png')} alt="Task reference: a vintage typewriter" width="512" height="320" loading="lazy"/><span>REFERENCE</span></div>
      <div class="wf-prompt"><span class="wf-chat-icon">↳</span><p>Recreate this in 3D.</p></div>
    </div>
    <div class="wf-or"><span></span>or<span></span></div>
    <div class="wf-text"><span class="wf-text-icon">T<span>_</span></span><p>Build an interactive Minecraft village, including connected streets, explorable houses, and functional doors and chests.</p></div>
  </div>
  <div class="wf-agent">
    <div class="wf-connection wf-connection-left" aria-hidden="true"></div>
    <svg class="wf-robot" viewBox="0 0 220 230" role="img" aria-label="Coding agent robot">
      <defs>
        <linearGradient id="wf-shell" x1="0" y1="0" x2=".7" y2="1"><stop stop-color="#ffffff"/><stop offset=".55" stop-color="#f2f4ec"/><stop offset="1" stop-color="#bccdc5"/></linearGradient>
        <linearGradient id="wf-face" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#264b4c"/><stop offset="1" stop-color="#102b32"/></linearGradient>
        <radialGradient id="wf-glow"><stop stop-color="#c0ded2" stop-opacity=".75"/><stop offset="1" stop-color="#c0ded2" stop-opacity="0"/></radialGradient>
        <filter id="wf-shadow" x="-50%" y="-30%" width="200%" height="180%"><feDropShadow dx="0" dy="8" stdDeviation="7" flood-color="#224e45" flood-opacity=".18"/></filter>
      </defs>
      <circle cx="110" cy="114" r="108" fill="url(#wf-glow)"/>
      <ellipse cx="110" cy="206" rx="45" ry="7" fill="#34564e" opacity=".08"/>
      <g filter="url(#wf-shadow)">
        <path d="M106 56V39" stroke="#7d9c91" stroke-width="7" stroke-linecap="round"/><circle cx="106" cy="32" r="9" fill="#70b9a2" stroke="#d8efe5" stroke-width="3"/>
        <rect x="45" y="83" width="19" height="42" rx="9" fill="#a5beb2"/><rect x="156" y="83" width="19" height="42" rx="9" fill="#a5beb2"/>
        <rect x="54" y="57" width="112" height="88" rx="32" fill="url(#wf-shell)" stroke="#fff" stroke-width="2"/>
        <rect x="66" y="75" width="88" height="52" rx="19" fill="url(#wf-face)"/>
        <path d="M81 96Q88 88 95 96M124 96Q131 88 138 96" fill="none" stroke="#9fe8cd" stroke-width="5" stroke-linecap="round"/>
        <path d="M101 110Q110 116 119 110" fill="none" stroke="#9fe8cd" stroke-width="3" stroke-linecap="round"/>
        <rect x="78" y="147" width="64" height="45" rx="20" fill="url(#wf-shell)" stroke="#fff"/>
        <path d="m102 164-6 5 6 5m16-10 6 5-6 5m-5-12-5 14" stroke="#4d8679" stroke-width="2.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M69 157 59 176M151 157l10 17" stroke="#c9d8ce" stroke-width="13" stroke-linecap="round"/>
        <path d="m94 192-3 8m35-8 3 8" stroke="#a9c0b3" stroke-width="10" stroke-linecap="round"/>
      </g>
      <path d="M184 59v12m-6-6h12M29 141v8m-4-4h8" stroke="#89ab9d" stroke-width="2" stroke-linecap="round"/>
      <circle cx="29" cy="69" r="3" fill="#c2d5c8"/>
    </svg>
    <h3>Coding agent</h3>
    <div class="wf-connection wf-connection-right" aria-hidden="true"></div>
  </div>
  <div class="wf-output">
    <div class="wf-label">OUTPUT <b><i></i> Editable</b></div>
    <div class="wf-editors">
      {editors.map(e => <figure class={`wf-editor wf-${e.kind}`} aria-label={`${e.name} editor illustration with generated ${e.selected} asset`}>
        <div class="wf-titlebar"><span class="wf-app-icon">{e.kind === 'blender' ? '◉' : 'U'}</span><strong>{e.name} <span class="wf-engine-level">({e.levels})</span></strong><span class="wf-filename">{e.file}</span><span class="wf-window-controls">− &nbsp; □</span></div>
        <div class="wf-menu"><span>File</span><span>Edit</span>{e.tabs.map(t=><span>{t}</span>)}<b>{e.kind === 'unreal' ? '▶ Play' : 'Object Mode'}</b></div>
        <div class="wf-editor-body">
          <div class="wf-viewport"><img src={asset(`media/${e.image}`)} alt={`Generated ${e.selected} inside an illustrative ${e.name} viewport`} width="512" height="320" loading="lazy"/><div class="wf-view-label">{e.kind === 'blender' ? 'User Perspective' : 'Perspective · Lit'}</div><div class="wf-tools" aria-hidden="true"><span>↖</span><span>✥</span><span>⟳</span><span>⤢</span></div><svg class="wf-gizmo" viewBox="0 0 48 48" aria-hidden="true"><path d="M23 25V5" stroke="#73a6ed" stroke-width="2"/><path d="m23 25 18 10" stroke="#e37669" stroke-width="2"/><path d="M23 25 6 34" stroke="#9ac16d" stroke-width="2"/><circle cx="23" cy="25" r="4" fill="#e9eeee"/><text x="20" y="7" fill="#a6c7f7">Z</text><text x="38" y="42" fill="#ed978c">X</text><text x="1" y="42" fill="#b4d68d">Y</text></svg></div>
          <aside class="wf-inspector"><div class="wf-panel-title">{e.kind === 'blender' ? 'Scene Collection' : 'World Outliner'}</div><ul>{e.objects.map(o=><li class:list={{'wf-selected':o === e.selected}}><span>◇</span>{o}<i>◉</i></li>)}</ul><div class="wf-panel-title">{e.kind === 'blender' ? 'Transform' : 'Details · Transform'}</div><div class="wf-props">{['Location','Rotation','Scale'].map((p,i)=><div><span>{p}</span><b>{i===2?'1.000':'0.000'}</b></div>)}</div></aside>
        </div>
        {e.kind==='blender' ? <div class="wf-timeline"><span>◂ ▷ ▸</span><div><i></i>{[0,20,40,60,80,100,120].map(n=><span>{n}</span>)}</div></div> : <div class="wf-content"><span>Content Browser</span><div>{['Maps','Meshes','Materials','Blueprints'].map(n=><span><i>▰</i>{n}</span>)}</div></div>}
        <figcaption><span>{e.footer}</span><strong>{e.kind==='blender'?'.blend':'.uproject'}</strong></figcaption>
      </figure>)}
    </div>
  </div>
</div>
<style>
.wf{display:grid;grid-template-columns:1fr .65fr 1.75fr;align-items:center;gap:24px;padding:38px 0 8px;position:relative}.wf-label{font-size:13px;font-weight:600;color:#425d59;display:flex;align-items:center;gap:9px;margin-bottom:18px}.wf-label>span{font:11px monospace;color:#839c91}.wf-label>b{margin-left:auto;font-size:10px;display:flex;align-items:center;gap:5px;background:#e0ece2;color:#3d725e;border:1px solid #c8dfce;border-radius:20px;padding:4px 8px;font-weight:500}.wf-label i{width:5px;height:5px;border-radius:50%;background:#589a72}.wf-reference{background:#fffefb;border:1px solid #dddeda;border-radius:12px;overflow:hidden;box-shadow:0 8px 24px #2b493908}.wf-photo{position:relative;background:#f0f0eb}.wf-photo img{display:block;width:100%;aspect-ratio:1.43;object-fit:cover}.wf-photo>span{position:absolute;top:12px;left:12px;background:#fffdf0cc;padding:4px 6px;border-radius:3px;font-size:8px;color:#6c7971;letter-spacing:.13em}.wf-prompt{display:flex;align-items:center;gap:10px;padding:16px 14px;border-top:1px solid #e9e9df}.wf-prompt p,.wf-text p{margin:0;font-size:13px;line-height:1.6;color:#304a43}.wf-chat-icon{color:#7ca396;font-size:21px}.wf-or{display:flex;align-items:center;gap:12px;justify-content:center;font:italic 14px Georgia,serif;color:#8a968d;margin:14px 30px}.wf-or span{height:1px;background:#dbe0d7;flex:1}.wf-text{display:flex;align-items:center;gap:12px;padding:16px 14px;border:1px solid #d7ded2;border-radius:10px;background:#edf1e8}.wf-text-icon{font:22px Georgia,serif;color:#537f6a}.wf-text-icon span{font-size:16px}.wf-agent{text-align:center;position:relative;padding-top:15px}.wf-robot{width:100%;max-width:210px;overflow:visible;display:block;margin:auto}.wf-agent h3{font:600 19px Georgia,serif;letter-spacing:-.3px;margin:5px 0 8px;color:#244c43}.wf-agent p{font-size:10px;letter-spacing:.035em;color:#80978b;margin:0}.wf-connection{position:absolute;height:1px;width:32px;top:48%;background:#abc4b7}.wf-connection:after{content:'';border:solid #90afa0;border-width:1px 1px 0 0;width:5px;height:5px;transform:rotate(45deg);position:absolute;right:0;top:-2px}.wf-connection-left{left:-28px}.wf-connection-right{right:-28px}.wf-editors{display:grid;gap:18px;perspective:1200px}.wf-editor{margin:0!important;background:#23282c;color:#d0d3d5;border:1px solid #39423f;border-radius:7px;overflow:hidden;box-shadow:0 8px 22px #18392a18;font-family:Arial,sans-serif}.wf-titlebar{height:29px;display:flex;align-items:center;gap:7px;padding:0 10px;background:#303638;font-size:10px}.wf-engine-level{font-size:.9em;color:#aebfb6;font-weight:400}.wf-titlebar strong{font-weight:600;color:#f4f3ef}.wf-app-icon{font-size:17px;line-height:1;color:#f09d54;font-weight:bold}.wf-unreal .wf-app-icon{font-family:Georgia,serif;color:#eee;border:1px solid #a5b0ad;border-radius:50%;font-size:11px;width:17px;height:17px;display:grid;place-items:center}.wf-filename{font-size:9px;color:#a0b0a8;margin-left:auto}.wf-window-controls{font-size:9px;color:#9da6a2;margin-left:8px}.wf-menu{display:flex;gap:11px;font-size:7px;height:22px;align-items:center;padding:0 10px;background:#252b2e;border-bottom:1px solid #171c1d;color:#abb5b1}.wf-menu>b{margin-left:auto;font-size:7px;font-weight:400;color:#d5dfd6}.wf-unreal .wf-menu>b{color:#a1d6a6}.wf-editor-body{display:grid;grid-template-columns:minmax(0,1fr) 28%;height:165px}.wf-viewport{position:relative;overflow:hidden;background:#848b8d}.wf-viewport img{width:100%;height:100%;object-fit:cover;display:block}.wf-view-label{position:absolute;left:7px;top:6px;font-size:7px;color:#eee;text-shadow:0 1px 3px #000}.wf-tools{position:absolute;left:5px;top:25px;display:flex;flex-direction:column;gap:3px;color:#dde4e2;background:#2c343955;border-radius:3px}.wf-tools span{font-size:11px;padding:1px 4px}.wf-gizmo{position:absolute;bottom:7px;right:6px;width:31px;height:31px;font-size:8px}.wf-inspector{background:#282e30;border-left:1px solid #171d1e;overflow:hidden}.wf-panel-title{font-size:7px;background:#333a3c;padding:5px 6px;color:#d4d9d7;white-space:nowrap}.wf-inspector ul{list-style:none;margin:4px 0 5px;padding:0;font-size:7px}.wf-inspector li{display:flex;gap:4px;padding:3px 6px;white-space:nowrap}.wf-inspector li>span{color:#db9e61}.wf-inspector li>i{font-style:normal;font-size:5px;color:#909f98;margin-left:auto}.wf-inspector .wf-selected{background:#455c61;color:#edf6f1}.wf-props{padding:4px 6px}.wf-props>div{display:flex;justify-content:space-between;font-size:6px;margin:4px 0;gap:3px}.wf-props b{font-weight:400;background:#3b4546;padding:1px 4px;min-width:29px;text-align:center}.wf-timeline{display:flex;height:20px;background:#2c3436;border-top:1px solid #1d2526;align-items:center;font-size:7px;padding:0 7px;gap:18px}.wf-timeline>div{display:flex;flex:1;justify-content:space-between;position:relative;background:repeating-linear-gradient(90deg,transparent 0 9px,#9aaa9b20 9px 10px)}.wf-timeline i{position:absolute;width:1px;height:17px;background:#84c3d4;left:27%;top:-2px}.wf-content{display:flex;align-items:center;gap:16px;height:30px;border-top:1px solid #1d2526;padding:0 8px;font-size:6px}.wf-content>span{font-size:7px;color:#b6c8bf}.wf-content>div{display:flex;gap:15px}.wf-content>div>span{display:flex;align-items:center;gap:4px}.wf-content i{font-size:14px;font-style:normal;color:#91aab8}.wf-editor figcaption{display:flex;justify-content:space-between;gap:8px;padding:7px 10px;font-size:8px;letter-spacing:.015em;color:#9daea6;background:#202729}.wf-editor figcaption strong{color:#dbdfd7;font-weight:400}.wf-unreal .wf-viewport img{object-position:center 52%}@media(min-width:1100px){.wf-editor-body{height:184px}.wf{gap:30px}.wf-prompt p,.wf-text p{font-size:14px}.wf-titlebar{height:32px;font-size:11px}.wf-filename{font-size:10px}.wf-menu,.wf-menu>b{font-size:8px}.wf-panel-title,.wf-inspector ul{font-size:8px}.wf-props>div{font-size:7px}.wf-editor figcaption{font-size:9px}}@media(max-width:760px){.wf{grid-template-columns:1fr;gap:25px;padding:16px 0 0;max-width:530px;margin:auto}.wf-input{display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:center}.wf-input>.wf-label{grid-column:1/-1;margin:0}.wf-or{display:none}.wf-reference{height:100%}.wf-text{height:auto}.wf-text br{display:none}.wf-prompt br{display:none}.wf-prompt{padding:12px}.wf-prompt p,.wf-text p{font-size:12px}.wf-agent{display:flex;align-items:center;justify-content:center;gap:15px;padding:0}.wf-robot{width:105px;margin:0}.wf-agent h3{font-size:21px;margin:0}.wf-agent p{display:none}.wf-connection{top:auto;bottom:0;width:26px;left:50%;right:auto;transform:rotate(90deg)}.wf-connection-left{top:0;bottom:auto}.wf-label{font-size:13px}.wf-editor-body{height:190px}.wf-output .wf-label{margin-bottom:14px}}@media(prefers-reduced-motion:no-preference){.wf-robot{animation:wf-hover 6s ease-in-out infinite}@keyframes wf-hover{50%{transform:translateY(-4px)}}}
.wf-prompt p{white-space:nowrap}@media(max-width:420px){.wf-input{grid-template-columns:1fr}.wf-reference{height:auto}}
</style>
